# ───────── Required ─────────
NODE_ENV=production
PORT=4000
# PostgreSQL connection (docker-compose builds this from POSTGRES_PASSWORD)
DATABASE_URL=postgres://tael:CHANGE_ME@localhost:5432/tael_books
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_password
# 32+ random characters. Encrypts stored secrets (AI keys, SMTP passwords). Keep it safe — losing it means re-entering those secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_ENCRYPTION_KEY=CHANGE_ME_generate_a_random_value

# ───────── First run: Super Admin (remove the password after the first start) ─────────
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=ChangeThis-2026
SUPER_ADMIN_NAME=Tabo Linyama
COMPANY_NAME=TAEL Finance & Business Solutions

# ───────── Optional ─────────
APP_URL=https://books.example.com
# true when served over HTTPS (default in production)
COOKIE_SECURE=true
# Number of proxies in front of the app (Caddy/Nginx/Render = 1)
TRUST_PROXY=1
DATABASE_SSL=false
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=15
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
# AI: a platform-wide Anthropic key (can also be set per company in Admin Center → AI settings)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Background jobs (notifications, recurring journals, anomaly scans). Leave on for one instance.
JOBS_ENABLED=true
# Create the clearly-labelled demo company on startup
SEED_DEMO=false
LOG_LEVEL=info
